{"commands":[
{"command":"parameters.add","params":{"name":"ply","expression":"3 mm","comment":"sheet thickness: the plates, the walls, each plug layer, and every tab's depth"}},
{"command":"parameters.add","params":{"name":"finger","expression":"2*ply","comment":"a finger's width, and the space between two on the end walls"}},
{"command":"parameters.add","params":{"name":"finger_end","expression":"2*finger","comment":"the end walls' fingers stay this far from each end"}},
{"command":"parameters.add","params":{"name":"tab_pitch","expression":"40 mm","comment":"an inner wall's tabs, this far apart"}},
{"command":"parameters.add","params":{"name":"over_clear","expression":"4 mm","comment":"wall either side of a tab below a shorter pipe"}},
{"command":"parameters.add","params":{"name":"interf","expression":"0.12 mm","comment":"each plug's press-fit, over the bore each way"}},
{"command":"parameters.add","params":{"name":"temp_c","expression":"25","unit":"","comment":"the air's temperature, warm from the breath, degrees C"}},
{"command":"parameters.add","params":{"name":"c_mm_s","expression":"331300*sqrt(1 + temp_c/273.15)","unit":"","comment":"speed of sound, mm/s"}},
{"command":"parameters.add","params":{"name":"a4","expression":"440","unit":"","comment":"concert pitch, Hz"}},
{"command":"parameters.add","params":{"name":"end","expression":"0.61","unit":"","comment":"the open end's correction, times the bore's equivalent radius"}},
{"command":"parameters.add","params":{"name":"depth","expression":"20 mm","comment":"every bore, front to back"}},
{"command":"parameters.add","params":{"name":"w_low","expression":"22 mm","comment":"the lowest pipe's bore, across the raft"}},
{"command":"parameters.add","params":{"name":"w_high","expression":"16 mm","comment":"the highest pipe's; those between step evenly"}},
{"command":"parameters.add","params":{"name":"spare","expression":"12 mm","comment":"empty pipe below each plug, so it can come down and flatten the note"}},
{"command":"parameters.add","params":{"name":"f_1","expression":"a4*pow(2, (-17)/12)","unit":"","comment":"pipe 1's note, Hz: E3 by default; type a frequency to retune it. Keep them rising"}},
{"command":"parameters.add","params":{"name":"w_1","expression":"w_low + (w_high - w_low)*0","comment":"pipe 1's bore across"}},
{"command":"parameters.add","params":{"name":"air_1","expression":"c_mm_s/(4*f_1)*1 mm - end*sqrt((w_1/(1 mm))*(depth/(1 mm))/pi)*1 mm","comment":"read only: pipe 1's air column, rim to plug face"}},
{"command":"parameters.add","params":{"name":"len_1","expression":"air_1 + 3*ply + spare","comment":"read only: pipe 1's length"}},
{"command":"parameters.add","params":{"name":"f_2","expression":"a4*pow(2, (-15)/12)","unit":"","comment":"pipe 2's note, Hz: F#3 by default; type a frequency to retune it. Keep them rising"}},
{"command":"parameters.add","params":{"name":"w_2","expression":"w_low + (w_high - w_low)*0.14285714285714285","comment":"pipe 2's bore across"}},
{"command":"parameters.add","params":{"name":"air_2","expression":"c_mm_s/(4*f_2)*1 mm - end*sqrt((w_2/(1 mm))*(depth/(1 mm))/pi)*1 mm","comment":"read only: pipe 2's air column, rim to plug face"}},
{"command":"parameters.add","params":{"name":"len_2","expression":"air_2 + 3*ply + spare","comment":"read only: pipe 2's length"}},
{"command":"parameters.add","params":{"name":"f_3","expression":"a4*pow(2, (-14)/12)","unit":"","comment":"pipe 3's note, Hz: G3 by default; type a frequency to retune it. Keep them rising"}},
{"command":"parameters.add","params":{"name":"w_3","expression":"w_low + (w_high - w_low)*0.2857142857142857","comment":"pipe 3's bore across"}},
{"command":"parameters.add","params":{"name":"air_3","expression":"c_mm_s/(4*f_3)*1 mm - end*sqrt((w_3/(1 mm))*(depth/(1 mm))/pi)*1 mm","comment":"read only: pipe 3's air column, rim to plug face"}},
{"command":"parameters.add","params":{"name":"len_3","expression":"air_3 + 3*ply + spare","comment":"read only: pipe 3's length"}},
{"command":"parameters.add","params":{"name":"f_4","expression":"a4*pow(2, (-12)/12)","unit":"","comment":"pipe 4's note, Hz: A3 by default; type a frequency to retune it. Keep them rising"}},
{"command":"parameters.add","params":{"name":"w_4","expression":"w_low + (w_high - w_low)*0.42857142857142855","comment":"pipe 4's bore across"}},
{"command":"parameters.add","params":{"name":"air_4","expression":"c_mm_s/(4*f_4)*1 mm - end*sqrt((w_4/(1 mm))*(depth/(1 mm))/pi)*1 mm","comment":"read only: pipe 4's air column, rim to plug face"}},
{"command":"parameters.add","params":{"name":"len_4","expression":"air_4 + 3*ply + spare","comment":"read only: pipe 4's length"}},
{"command":"parameters.add","params":{"name":"f_5","expression":"a4*pow(2, (-10)/12)","unit":"","comment":"pipe 5's note, Hz: B3 by default; type a frequency to retune it. Keep them rising"}},
{"command":"parameters.add","params":{"name":"w_5","expression":"w_low + (w_high - w_low)*0.5714285714285714","comment":"pipe 5's bore across"}},
{"command":"parameters.add","params":{"name":"air_5","expression":"c_mm_s/(4*f_5)*1 mm - end*sqrt((w_5/(1 mm))*(depth/(1 mm))/pi)*1 mm","comment":"read only: pipe 5's air column, rim to plug face"}},
{"command":"parameters.add","params":{"name":"len_5","expression":"air_5 + 3*ply + spare","comment":"read only: pipe 5's length"}},
{"command":"parameters.add","params":{"name":"f_6","expression":"a4*pow(2, (-9)/12)","unit":"","comment":"pipe 6's note, Hz: C4 by default; type a frequency to retune it. Keep them rising"}},
{"command":"parameters.add","params":{"name":"w_6","expression":"w_low + (w_high - w_low)*0.7142857142857143","comment":"pipe 6's bore across"}},
{"command":"parameters.add","params":{"name":"air_6","expression":"c_mm_s/(4*f_6)*1 mm - end*sqrt((w_6/(1 mm))*(depth/(1 mm))/pi)*1 mm","comment":"read only: pipe 6's air column, rim to plug face"}},
{"command":"parameters.add","params":{"name":"len_6","expression":"air_6 + 3*ply + spare","comment":"read only: pipe 6's length"}},
{"command":"parameters.add","params":{"name":"f_7","expression":"a4*pow(2, (-7)/12)","unit":"","comment":"pipe 7's note, Hz: D4 by default; type a frequency to retune it. Keep them rising"}},
{"command":"parameters.add","params":{"name":"w_7","expression":"w_low + (w_high - w_low)*0.8571428571428571","comment":"pipe 7's bore across"}},
{"command":"parameters.add","params":{"name":"air_7","expression":"c_mm_s/(4*f_7)*1 mm - end*sqrt((w_7/(1 mm))*(depth/(1 mm))/pi)*1 mm","comment":"read only: pipe 7's air column, rim to plug face"}},
{"command":"parameters.add","params":{"name":"len_7","expression":"air_7 + 3*ply + spare","comment":"read only: pipe 7's length"}},
{"command":"parameters.add","params":{"name":"f_8","expression":"a4*pow(2, (-5)/12)","unit":"","comment":"pipe 8's note, Hz: E4 by default; type a frequency to retune it. Keep them rising"}},
{"command":"parameters.add","params":{"name":"w_8","expression":"w_low + (w_high - w_low)*1","comment":"pipe 8's bore across"}},
{"command":"parameters.add","params":{"name":"air_8","expression":"c_mm_s/(4*f_8)*1 mm - end*sqrt((w_8/(1 mm))*(depth/(1 mm))/pi)*1 mm","comment":"read only: pipe 8's air column, rim to plug face"}},
{"command":"parameters.add","params":{"name":"len_8","expression":"air_8 + 3*ply + spare","comment":"read only: pipe 8's length"}},
{"command":"parameters.add","params":{"name":"y_0","expression":"0 mm","comment":"wall 0's outer face"}},
{"command":"parameters.add","params":{"name":"y_1","expression":"y_0 + ply + w_1","comment":"read only: where wall 1 starts across the raft"}},
{"command":"parameters.add","params":{"name":"y_2","expression":"y_1 + ply + w_2","comment":"read only: where wall 2 starts across the raft"}},
{"command":"parameters.add","params":{"name":"y_3","expression":"y_2 + ply + w_3","comment":"read only: where wall 3 starts across the raft"}},
{"command":"parameters.add","params":{"name":"y_4","expression":"y_3 + ply + w_4","comment":"read only: where wall 4 starts across the raft"}},
{"command":"parameters.add","params":{"name":"y_5","expression":"y_4 + ply + w_5","comment":"read only: where wall 5 starts across the raft"}},
{"command":"parameters.add","params":{"name":"y_6","expression":"y_5 + ply + w_6","comment":"read only: where wall 6 starts across the raft"}},
{"command":"parameters.add","params":{"name":"y_7","expression":"y_6 + ply + w_7","comment":"read only: where wall 7 starts across the raft"}},
{"command":"parameters.add","params":{"name":"y_8","expression":"y_7 + ply + w_8","comment":"read only: where wall 8 starts across the raft"}},
{"command":"parameters.add","params":{"name":"raft_w","expression":"y_8 + ply","comment":"read only: the raft across"}},
{"command":"parameters.add","params":{"name":"bed_room","expression":"589.87 mm - len_1","comment":"read only: what the bed leaves past the longest pipe (the plates are as long); below 0 it does not fit the laser"}},
{"command":"solid.box","params":{"corner":["-(y_1 + ply)","-ply","-(len_1)"],"length":"(y_1 + ply) - (0 mm)","width":"(0 mm) - (-ply)","height":"(len_1) - (0 mm)","operation":"new","name":"front plate #1","body_name":"front plate #1"}},
{"command":"solid.box","params":{"corner":["-(y_2 + ply)","-ply","-(len_2)"],"length":"(y_2 + ply) - (y_1 + ply)","width":"(0 mm) - (-ply)","height":"(len_2) - (0 mm)","operation":"join","targets":["front plate #1"],"name":"front plate #1, pipe 2"}},
{"command":"solid.box","params":{"corner":["-(y_3 + ply)","-ply","-(len_3)"],"length":"(y_3 + ply) - (y_2 + ply)","width":"(0 mm) - (-ply)","height":"(len_3) - (0 mm)","operation":"join","targets":["front plate #1"],"name":"front plate #1, pipe 3"}},
{"command":"solid.box","params":{"corner":["-(y_4 + ply)","-ply","-(len_4)"],"length":"(y_4 + ply) - (y_3 + ply)","width":"(0 mm) - (-ply)","height":"(len_4) - (0 mm)","operation":"join","targets":["front plate #1"],"name":"front plate #1, pipe 4"}},
{"command":"solid.box","params":{"corner":["-(y_5 + ply)","-ply","-(len_5)"],"length":"(y_5 + ply) - (y_4 + ply)","width":"(0 mm) - (-ply)","height":"(len_5) - (0 mm)","operation":"join","targets":["front plate #1"],"name":"front plate #1, pipe 5"}},
{"command":"solid.box","params":{"corner":["-(y_6 + ply)","-ply","-(len_6)"],"length":"(y_6 + ply) - (y_5 + ply)","width":"(0 mm) - (-ply)","height":"(len_6) - (0 mm)","operation":"join","targets":["front plate #1"],"name":"front plate #1, pipe 6"}},
{"command":"solid.box","params":{"corner":["-(y_7 + ply)","-ply","-(len_7)"],"length":"(y_7 + ply) - (y_6 + ply)","width":"(0 mm) - (-ply)","height":"(len_7) - (0 mm)","operation":"join","targets":["front plate #1"],"name":"front plate #1, pipe 7"}},
{"command":"solid.box","params":{"corner":["-(y_8 + ply)","-ply","-(len_8)"],"length":"(y_8 + ply) - (y_7 + ply)","width":"(0 mm) - (-ply)","height":"(len_8) - (0 mm)","operation":"join","targets":["front plate #1"],"name":"front plate #1, pipe 8"}},
{"command":"solid.box","params":{"corner":["-(y_1 + ply)","depth","-(len_1)"],"length":"(y_1 + ply) - (0 mm)","width":"(depth + ply) - (depth)","height":"(len_1) - (0 mm)","operation":"new","name":"back plate #2","body_name":"back plate #2"}},
{"command":"solid.box","params":{"corner":["-(y_2 + ply)","depth","-(len_2)"],"length":"(y_2 + ply) - (y_1 + ply)","width":"(depth + ply) - (depth)","height":"(len_2) - (0 mm)","operation":"join","targets":["back plate #2"],"name":"back plate #2, pipe 2"}},
{"command":"solid.box","params":{"corner":["-(y_3 + ply)","depth","-(len_3)"],"length":"(y_3 + ply) - (y_2 + ply)","width":"(depth + ply) - (depth)","height":"(len_3) - (0 mm)","operation":"join","targets":["back plate #2"],"name":"back plate #2, pipe 3"}},
{"command":"solid.box","params":{"corner":["-(y_4 + ply)","depth","-(len_4)"],"length":"(y_4 + ply) - (y_3 + ply)","width":"(depth + ply) - (depth)","height":"(len_4) - (0 mm)","operation":"join","targets":["back plate #2"],"name":"back plate #2, pipe 4"}},
{"command":"solid.box","params":{"corner":["-(y_5 + ply)","depth","-(len_5)"],"length":"(y_5 + ply) - (y_4 + ply)","width":"(depth + ply) - (depth)","height":"(len_5) - (0 mm)","operation":"join","targets":["back plate #2"],"name":"back plate #2, pipe 5"}},
{"command":"solid.box","params":{"corner":["-(y_6 + ply)","depth","-(len_6)"],"length":"(y_6 + ply) - (y_5 + ply)","width":"(depth + ply) - (depth)","height":"(len_6) - (0 mm)","operation":"join","targets":["back plate #2"],"name":"back plate #2, pipe 6"}},
{"command":"solid.box","params":{"corner":["-(y_7 + ply)","depth","-(len_7)"],"length":"(y_7 + ply) - (y_6 + ply)","width":"(depth + ply) - (depth)","height":"(len_7) - (0 mm)","operation":"join","targets":["back plate #2"],"name":"back plate #2, pipe 7"}},
{"command":"solid.box","params":{"corner":["-(y_8 + ply)","depth","-(len_8)"],"length":"(y_8 + ply) - (y_7 + ply)","width":"(depth + ply) - (depth)","height":"(len_8) - (0 mm)","operation":"join","targets":["back plate #2"],"name":"back plate #2, pipe 8"}},
{"command":"solid.box","params":{"corner":["-(y_0 + ply)","0 mm","-(len_1)"],"length":"(y_0 + ply) - (y_0)","width":"(depth) - (0 mm)","height":"(len_1) - (0 mm)","operation":"new","name":"end wall #3","body_name":"end wall #3"}},
{"command":"parameters.add","params":{"name":"n_end_0","expression":"floor((len_1 - 2*finger_end - finger)/(2*finger)) + 1","unit":"","comment":"read only: wall 0's fingers each edge"}},
{"command":"solid.box","params":{"corner":["-(y_0 + ply)","-ply","-(len_1/2 - (n_end_0 - 1)*finger + finger/2 + 0 mm)"],"length":"(y_0 + ply) - (y_0)","width":"(depth + ply) - (-ply)","height":"(len_1/2 - (n_end_0 - 1)*finger + finger/2 + 0 mm) - (len_1/2 - (n_end_0 - 1)*finger - finger/2 + 0 mm)","operation":"join","targets":["end wall #3"],"name":"end wall #3 tabs 1"}},
{"command":"solid.pattern.rectangular","params":{"features":["end wall #3 tabs 1"],"dir1":[0,0,-1],"count1":"n_end_0","spacing1":"2*finger","name":"end wall #3 tabs 1 pattern"}},
{"command":"solid.box","params":{"corner":["-(y_0 + ply)","-ply","-(len_1/2 - (n_end_0 - 1)*finger + finger/2 + 0 mm)"],"length":"(y_0 + ply) - (y_0)","width":"(depth + ply) - (-ply)","height":"(len_1/2 - (n_end_0 - 1)*finger + finger/2 + 0 mm) - (len_1/2 - (n_end_0 - 1)*finger - finger/2 + 0 mm)","operation":"cut","targets":["front plate #1","back plate #2"],"name":"end wall #3 slots 1"}},
{"command":"solid.pattern.rectangular","params":{"features":["end wall #3 slots 1"],"dir1":[0,0,-1],"count1":"n_end_0","spacing1":"2*finger","name":"end wall #3 slots 1 pattern"}},
{"command":"solid.box","params":{"corner":["-(y_1 + ply)","0 mm","-(len_1)"],"length":"(y_1 + ply) - (y_1)","width":"(depth) - (0 mm)","height":"(len_1) - (0 mm)","operation":"new","name":"wall #4","body_name":"wall #4"}},
{"command":"parameters.add","params":{"name":"n_tab_1","expression":"floor((len_2 - 2*finger_end - finger)/tab_pitch) + 1","unit":"","comment":"read only: wall 1's tabs through the slots, each edge"}},
{"command":"parameters.add","params":{"name":"n_low_1","expression":"max(1, floor((((len_1) - (len_2)) - 2*over_clear - finger)/tab_pitch) + 1)","unit":"","comment":"read only: wall 1's tabs below pipe 2, in notches in the staircase"}},
{"command":"parameters.add","params":{"name":"has_low_1","expression":"min(1, max(0, floor(((len_1) - (len_2))/(finger + 2*over_clear))))","unit":"","comment":"read only: 1 if wall 1 reaches far enough below pipe 2 for a tab"}},
{"command":"solid.box","params":{"corner":["-(y_1 + ply)","-ply","-(len_2/2 - (n_tab_1 - 1)*tab_pitch/2 + finger/2 + 0 mm)"],"length":"(y_1 + ply) - (y_1)","width":"(depth + ply) - (-ply)","height":"(len_2/2 - (n_tab_1 - 1)*tab_pitch/2 + finger/2 + 0 mm) - (len_2/2 - (n_tab_1 - 1)*tab_pitch/2 - finger/2 + 0 mm)","operation":"join","targets":["wall #4"],"name":"wall #4 tabs 1"}},
{"command":"solid.pattern.rectangular","params":{"features":["wall #4 tabs 1"],"dir1":[0,0,-1],"count1":"n_tab_1","spacing1":"tab_pitch","name":"wall #4 tabs 1 pattern"}},
