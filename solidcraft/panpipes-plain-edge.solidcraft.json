{"command":"solid.pattern.rectangular","params":{"features":["wall #4 slots 1"],"dir1":[0,0,-1],"count1":"n_tab_1","spacing1":"tab_pitch","name":"wall #4 slots 1 pattern"}},
{"command":"solid.box","params":{"corner":["-(y_1 + ply)","-ply","-(len_2 + ((len_1) - (len_2))/2 - (n_low_1 - 1)*tab_pitch/2 + finger/2 + (1 - has_low_1)*10000 mm)"],"length":"(y_1 + ply) - (y_1)","width":"(depth + ply) - (-ply)","height":"(len_2 + ((len_1) - (len_2))/2 - (n_low_1 - 1)*tab_pitch/2 + finger/2 + (1 - has_low_1)*10000 mm) - (len_2 + ((len_1) - (len_2))/2 - (n_low_1 - 1)*tab_pitch/2 - finger/2 + (1 - has_low_1)*10000 mm)","operation":"join","targets":["wall #4"],"name":"wall #4 tabs 2"}},
{"command":"solid.pattern.rectangular","params":{"features":["wall #4 tabs 2"],"dir1":[0,0,-1],"count1":"n_low_1","spacing1":"tab_pitch","name":"wall #4 tabs 2 pattern"}},
