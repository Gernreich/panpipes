{"command":"parameters.add","params":{"name":"n_tab_2","expression":"floor((len_3 - 2*finger_end - finger)/tab_pitch) + 1","unit":"","comment":"read only: wall 2's tabs through the slots, each edge"}},
{"command":"parameters.add","params":{"name":"n_low_2","expression":"max(1, floor((((len_2) - (len_3)) - 2*over_clear - finger)/tab_pitch) + 1)","unit":"","comment":"read only: wall 2's tabs below pipe 3, in notches in the staircase"}},
{"command":"parameters.add","params":{"name":"has_low_2","expression":"min(1, max(0, floor(((len_2) - (len_3))/(finger + 2*over_clear))))","unit":"","comment":"read only: 1 if wall 2 reaches far enough below pipe 3 for a tab"}},
{"command":"solid.box","params":{"corner":["-(y_2 + ply)","-ply","-(len_3/2 - (n_tab_2 - 1)*tab_pitch/2 + finger/2 + 0 mm)"],"length":"(y_2 + ply) - (y_2)","width":"(depth + ply) - (-ply)","height":"(len_3/2 - (n_tab_2 - 1)*tab_pitch/2 + finger/2 + 0 mm) - (len_3/2 - (n_tab_2 - 1)*tab_pitch/2 - finger/2 + 0 mm)","operation":"join","targets":["wall #5"],"name":"wall #5 tabs 1"}},
{"command":"solid.pattern.rectangular","params":{"features":["wall #5 tabs 1"],"dir1":[0,0,-1],"count1":"n_tab_2","spacing1":"tab_pitch","name":"wall #5 tabs 1 pattern"}},
