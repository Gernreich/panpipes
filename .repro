# --- the SolidCraft designs: every build as a parametric SolidCraft script,
# written by the generators from the same rules as the cut files ---
solidcraft/panpipes-chamfer-edge.solidcraft.json :: target/release/panpipes --edge=chamfer --no-write --solidcraft=$(dirname $OUT)
solidcraft/panpipes-plain-edge.solidcraft.json :: target/release/panpipes --edge=plain --no-write --solidcraft=$(dirname $OUT)
solidcraft/panpipes-notch-edge.solidcraft.json :: target/release/panpipes --edge=notch --no-write --solidcraft=$(dirname $OUT)
solidcraft/panpipes-strip-edge.solidcraft.json :: target/release/panpipes --edge=strip --no-write --solidcraft=$(dirname $OUT)
