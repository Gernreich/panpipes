# --- the designs as SolidCraft opens them: each script built and saved, the
# build cache left out (lasermade-tools' sc-slim) so the file is the same every time ---
solidcraft/panpipes-chamfer-edge.sc :: target/release/panpipes --edge=chamfer --no-write --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/panpipes-chamfer-edge.solidcraft.json --save $OUT --quiet && ../lasermade-tools/target/release/sc-slim $OUT
solidcraft/panpipes-plain-edge.sc :: target/release/panpipes --edge=plain --no-write --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/panpipes-plain-edge.solidcraft.json --save $OUT --quiet && ../lasermade-tools/target/release/sc-slim $OUT
solidcraft/panpipes-notch-edge.sc :: target/release/panpipes --edge=notch --no-write --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/panpipes-notch-edge.solidcraft.json --save $OUT --quiet && ../lasermade-tools/target/release/sc-slim $OUT
solidcraft/panpipes-strip-edge.sc :: target/release/panpipes --edge=strip --no-write --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/panpipes-strip-edge.solidcraft.json --save $OUT --quiet && ../lasermade-tools/target/release/sc-slim $OUT
